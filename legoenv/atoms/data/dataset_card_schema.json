{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "dataset card — one data-pool slug as profile_datasets.py writes it",
 "type": "object", "required": ["slug", "path", "tables", "archetypes_supported", "usable"],
 "properties": {"slug": {"type": "string"}, "path": {"type": "string"}, "size_bytes": {"type": ["integer", "null"]}, "license": {"type": ["string", "null"]}, "source": {"type": ["string", "null"]},
  "domains": {"type": "array", "items": {"type": "string"}, "description": "filled by tag_datasets.py or by hand"},
  "tables": {"type": "array", "items": {"type": "object", "required": ["file", "rows_sampled", "columns"], "properties": {
     "file": {"type": "string"}, "rows_sampled": {"type": "integer"}, "rows_est": {"type": ["integer", "null", "object"]},
     "columns": {"type": "array", "items": {"type": "object", "required": ["name", "type"], "properties": {"name": {"type": "string"}, "type": {"enum": ["numeric", "date", "category", "text", "id", "contact", "entity"]}, "n_distinct": {"type": "integer"}, "fill": {"type": "number"}, "examples": {"type": "array"}, "top": {"type": "array"}}}},
     "numeric_cols": {"type": "array"}, "date_cols": {"type": "array"}, "category_cols": {"type": "array"}, "contact_cols": {"type": "array"}, "archetypes_supported": {"type": "array"}}}},
  "archetypes_supported": {"type": "array", "items": {"type": "string"}}, "usable": {"type": "boolean", "description": "at least one table with >= 8 rows"}, "profiled": {"type": "string"}}}
