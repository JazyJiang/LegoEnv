# Standard OpenAI-compatible API. Load locally; never commit real keys.
OPENAI_BASE_URL=https://provider.example/v1
OPENAI_API_KEY=
OPENAI_MODEL=your-model-name

# Builder and teacher may use different providers/models: override their CLI
# --provider-base-url / --base-url, --model and --api-key-env independently.
# Provider-specific thinking controls are explicit --provider-extra-body or
# --extra-body JSON, not mandatory defaults for every compatible endpoint.
