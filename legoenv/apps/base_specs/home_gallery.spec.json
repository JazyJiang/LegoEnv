    {
      "tool": "sign_in",
      "description": "Sign in with a gallery account email and password. Every API route (searching entries, reading the tree, downloading source files, the event log) is behind basic-auth; the session this opens is what the server authenticates. All other tools refuse until you sign in.",
      "family": "guard.auth",
      "entity": "User",
      "input_schema": {
        "email": {
          "type": "text",
          "required": true,
          "description": "The account email."
        },
        "password": {
          "type": "text",
          "required": true,
          "description": "The account password."
        }
      },
      "exec_spec": {
        "verify": {
          "entity": "User"
        }
      },
      "_evidence": {
        "id_local": "sign_in",
        "locator": "basic-auth middleware (server.auth.users config)",
        "ref_code": "basic-auth/ip-whitelist gate the HTTP surface; users come from server.auth.users config, not a persisted table (collector summary / _no_edges notes)"
      }
    },
    {
      "tool": "entry_search",
      "description": "Search the whole gallery database for media entries. Returns a paginated list of matching Entry rows; the entire database is served, since per-user filtering is an optional config plugin that is off by default.",
      "family": "search",
      "entity": "Entry",
      "input_schema": {
        "q": {
          "type": "text",
          "required": false,
          "description": "Gallery query string; matched over each entry's text via substring. Empty matches every entry."
        },
        "offset": {
          "type": "int",
          "required": false,
          "description": "Pagination offset into the result list."
        },
        "limit": {
          "type": "int",
          "required": false,
          "description": "Maximum number of entries to return."
        }
      },
      "exec_spec": {
        "entity": "Entry",
        "rank": {
          "method": "substring"
        },
        "search_fields": [
          "description",
          "tags",
          "type",
          "make",
          "model",
          "country",
          "state",
          "city",
          "road",
          "house_number"
        ],
        "filter": {
          "op": "or",
          "clauses": [
