  "known_patches": [
    "env_id teampass",
    "Integer User.id=1 admin persona with known login/pw, plus persona ApiSession fixture required by original REST-list guard",
    "Optional search/limit filters on apifolder_list,apiuser_list,apimisc_refreshsettings,accessreview_export",
    "Remove apifolder_list erroneous folder-id equals actor-id scope; preserve its original ApiSession guard"
  ],
  "known_limitations": [
    "No Items list/search tool exists; do not invent item discovery. Known ids can be read with items_getpassword when share keys are seeded.",
    "items_create does not create SharekeyItem grants for a new item, so the original share-key-gated password read may be refused after creation.",
    "items_create read-only guard is an OR with folder existence; read-only users may create in existing folders. Item update/delete/move guards also do not implement full folder permission checks.",
    "ApiSession guards test global row existence, not the current actor/session. Preseeded persona session enables original REST reads but is not a JWT/session-isolation guarantee.",
    "Credential pw values are stored and read as supplied by the deterministic executor; no actual encryption/decryption or external password rotation is implemented.",
    "kb_save does not resolve/create category_id from category text; only updates to seeded KB records are advertised.",
    "accessreview_create creates metadata without snapshotting grants; accessreviewitem_decide records decision without removing the underlying grant.",
    "items_copy does not copy a source row/share keys; no full copy capability is advertised. Export returns records rather than formatted CSV."
  ],
  "smoke": {
    "passed": true,
    "date": "2026-10-24",
    "report": "ok"
  },
  "register_file": "pack/newspecs3/teampass/register.py",
  "base_spec": "pack/base_specs/teampass.spec.json"
