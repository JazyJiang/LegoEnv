{
  "app": "planka",
  "role": "project management / Kanban (Trello/Asana/Monday-style)",
  "domains": [
    "operations",
    "it_ops",
    "project_management"
  ],
  "kinds": {
    "create_or_move_card": [
      "create_card",
      "update_card"
    ],
    "create_or_update_issue": [
      "create_card",
      "update_card",
      "create_comment"
    ],
    "update_record": [
      "update_project",
      "update_board",
      "update_list",
      "update_task",
      "update_label",
      "update_comment"
    ],
    "create_record": [
      "create_project",
      "create_board",
      "create_list",
      "create_label",
      "create_task",
      "create_comment",
      "create_checklist"
    ],
    "assign_owner": [
      "add_card_member"
    ],
    "delete_or_archive_row": [
      "delete_card",
      "delete_task"
    ],
    "other:add_label": [
      "add_card_label",
      "create_label"
    ]
  },
  "check_kinds": [
    "card_exists_in_bucket",
    "card_not_moved",
    "issue_exists_with",
    "record_exists",
    "record_not_exists",
    "record_field_equals",
    "record_field_contains",
    "record_field_unchanged",
    "note_or_task_exists",
    "action_done",
    "action_not_done"
  ],
  "carriers": {
    "card_description": {
      "entity": "Card",
      "field": "description"
    }
  },
  "login": {
    "tool": "sign_in",
    "user_field": "email"
  },
  "content_entities": [
    "Project",
    "Board",
    "List",
    "Card",
    "TaskList",
    "Task",
    "Comment",
    "Label",
    "CardLabel",
    "CardMembership",
    "CustomFieldValue"
  ],
  "seed_helpers": [
    "kanban_board",
    "add_users",
    "comments"
  ],
  "tool_families_to_keep": [
    "create_",
    "update_",
    "delete_",
    "list_",
    "add_",
    "remove_",
    "show_",
    "set_",
    "clear_",
    "empty_",
    "mark_",
    "sign_"
  ],
  "obs_reads": [
    "list_projects",
    "list_users",
    "list_cards"
  ],
  "known_patches": [
    "env_id planka_ab",
    "Card.list_id id->text (update_card can move a card)",
    "Task.assignee_user_id id->text (update_task can reassign)",
    "list_projects/list_users/list_webhooks/list_notifications got a `search` substring filter (whole-list reads stay under 12k)",
    "persona (id 1, admin) seeded as a board editor + project manager so membership/project-manager preconditions pass for the signed-in persona"
  ],
  "smoke": {
    "passed": true,
    "date": "2026-10-24",
    "report": "ok"
  },
  "register_file": "pack/newspecs3/planka/register.py",
  "base_spec": "pack/base_specs/planka.spec.json"
}
