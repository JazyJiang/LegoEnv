{
  "app": "ghost",
  "role": "publishing / newsletter CMS (Ghost-style)",
  "domains": [
    "publishing",
    "editorial_operations"
  ],
  "kinds": {
    "create_or_update_doc": [
      "post_add",
      "post_edit"
    ],
    "update_record": [
      "post_edit"
    ],
    "delete_or_archive_row": [
      "post_destroy"
    ],
    "create_metadata": [
      "tag_add"
    ]
  },
