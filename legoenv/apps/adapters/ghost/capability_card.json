  "known_patches": [
    "env_id ghost",
    "Replace compiler demo seeds with integer persona User.id=1, Owner role binding and site title; domain rows seeded per world",
    "Optional search filters on post_browse.title, newsletter_browse.name and users_browse.name",
    "Remove users_browse owner scope to list the staff roster"
  ],
  "smoke": {
    "passed": true,
    "date": "2026-10-24",
    "report": "ok"
  },
  "register_file": "pack/newspecs3/ghost/register.py",
  "base_spec": "pack/base_specs/ghost.spec.json",
  "known_limitations": [
    "Original post_edit preconditions are author OR active newsletter; with an active newsletter other staff can edit a post. This source guard is preserved and tested; do not claim per-author edit isolation.",
    "post_add/post_edit expose authors, tags and meta arguments but do not maintain PostAuthor/PostTag/PostsMeta side rows. Builder helpers seed authorship; those relation-write capabilities are not advertised.",
    "post_copy does not fetch and copy source post content; callers would need to supply fields. Not advertised.",
    "No tag browse/read tool exists in the raw spec. Metadata creation is supported; no metadata discovery tool was invented.",
    "obs_report rejects oversized whole-list responses; search and limit permit scoped reads, but a single oversized content row must still be made smaller by the builder."
  ]
}
