{
  "app": "ckan",
  "role": "open-data catalog and dataset publication",
  "domains": [
    "government",
    "nonprofit",
    "research"
  ],
  "kinds": {
    "other:dataset_publish": [
      "package_create"
    ],
    "other:dataset_metadata_patch": [
      "package_patch"
    ],
    "other:resource_publish": [
      "resource_create"
    ]
  },
  "check_kinds": [
    "item_exists",
    "record_field_equals",
    "record_field_unchanged",
    "action_done",
    "action_not_done"
  ],
  "carriers": {
    "notes_field": {
      "entity": "Package",
      "field": "notes"
    }
  },
  "login": {
    "tool": "sign_in",
    "user_field": "email",
    "persona_entity": "User"
  },
  "content_entities": [
    "Package",
    "Resource",
    "Group",
    "Member",
    "PackageTag",
    "Tag"
  ],
  "seed_helpers": [
    "smoke_seed"
  ],
  "tool_families_to_keep": [
    "package",
    "resource",
    "group"
  ],
  "obs_reads": [
    "package_package_list",
    "resource_resource_search"
  ],
  "known_patches": [
    "Keep only an id-1 sysadmin persona in the base seed; per-pack data supplies catalog content."
  ],
  "smoke": {
    "passed": true,
    "date": "2026-10-24",
    "report": "ok"
  },
  "register_file": "pack/newspecs3/ckan/register.py",
  "base_spec": "pack/base_specs/ckan.spec.json",
  "known_limitations": [
    "An empty package_package_search query returns no rows; use package_package_list for discovery.",
    "package_patch persists supported scalar metadata and visibility fields only; use resource_create to attach resources.",
    "resource_create needs the actual parent Package.id; use the id returned by package_create for a newly created dataset."
  ]
}
